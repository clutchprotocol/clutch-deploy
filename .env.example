# Clutch Deploy - Environment Configuration
# Copy to .env and update values

# Seq (optional - for structured logging)
# Create this ingestion API key in Seq UI, then paste here.
SEQ_API_KEY=seq-ingestion-api-key
SEQ_ADMIN_USERNAME=admin
SEQ_ADMIN_PASSWORD=seq-admin-password

# JWT (if API requires). Hub API refuses to start on an empty/placeholder/short value.
JWT_SECRET=your-super-secret-jwt-key-here

# Grafana admin password. If unset, docker-compose.yml falls back to a committed default;
# set a private value here for any real environment.
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# CORS - allowed origins for API (comma-separated). Include your stage demo origin, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app-stage.clutchprotocol.io
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app-stage.clutchprotocol.io

# Explorer
EXPLORER_ALLOWED_ORIGINS=*
EXPLORER_POSTGRES_DB=clutch_explorer
EXPLORER_POSTGRES_USER=postgres
EXPLORER_POSTGRES_PASSWORD=postgres
EXPLORER_DEVELOPER_MODE=true
EXPLORER_CLEANUP_ON_START=true

# Where alerts go. Readiness item D3/D4: fifteen Prometheus rules exist and none of them reaches a
# human without these.
#
#   1. Message @BotFather on Telegram, /newbot, copy the token it gives you.
#   2. Send your new bot any message, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read chat.id from the response.
#      Negative for a group. The bot cannot message you until you have written to it first.
#
# deploy-stage.sh writes the token to config/monitoring/alertmanager/telegram-token and renders
# alertmanager.yml from the .tpl with the chat id substituted. Both are gitignored. Unset, the
# deploy renders placeholders, Alertmanager starts, and delivery fails visibly in its own log —
# which is honest, and is not the item being closed.
#
# The item closes when a forced failure has actually arrived: stop treasury-service for four
# minutes and confirm TreasuryServiceDown reaches you.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# The GasFree rail: USDT sweeps and payouts with no TRX, the relay's fee paid in USDT. OFF while
# GASFREE_NETWORK is unset. See clutch-treasury's docs/superpowers/specs/2026-09-24-gasfree-transfer-rail-design.md
# §6, and docs/ON-CALL.md "The GasFree rail". Values below are the testnet's (Nile).
#
# Keep every line set for as long as any user has a GasFree address, even after going back to
# TRANSFER_RAIL=trx. Put the key and the secret in unquoted, and never into a chat, a commit or a log.
# Keep each comment on its own line: check-cap-invariants.sh reads a value to the end of its line.
#
# TRANSFER_RAIL=gasfree
# GASFREE_NETWORK=nile
# GASFREE_API_URL=https://open-test.gasfree.io/nile
# GASFREE_API_KEY=
# GASFREE_API_SECRET=
# The relay's own address; PROBE=gasfree prints the provider list.
# GASFREE_SERVICE_PROVIDER=
# Above the live fees (1.00 and 0.30 on Nile). Users are charged these, "up to".
# GASFREE_ACTIVATE_FEE_MAX_USDT=1500000
# GASFREE_TRANSFER_FEE_MAX_USDT=500000
# After the fee, a deposit below this mints nothing and waits for a human.
# MIN_DEPOSIT_USDT=1000000
# GasFree's reviewed code; PROBE=gasfree prints the live values.
# GASFREE_EXPECTED_IMPLEMENTATION=b8eda40b467b45af107f198e94cc2fa1378adf50
# GASFREE_EXPECTED_CONTROLLER_IMPLEMENTATION=2ec1c0ada96ac9c3d6aab8e0c6e18194ed72c441
# At least the largest payout plus its relay fee.
# PAYOUT_FLOAT_TARGET_USDT=30000000
