# Environment
.env
.env.local
.env.*.local
# One env file per network (.env.testnet, .env.mainnet); .env is the old shared file, kept ignored
# for hosts and checkouts that still have one. Backups the treasury scripts take before editing them
# hold DEPOSIT_MNEMONIC, so each is exactly as sensitive as the file itself and must never be committable.
.env.bak
.env.bak.*
.env.testnet
.env.testnet.bak
.env.testnet.bak.*
.env.mainnet
.env.mainnet.bak
.env.mainnet.bak.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db


# Encrypted database dumps written by scripts/backup-treasury-db.sh. Encrypted, but still the
# whole off-chain ledger — never committable.
backups/

# Both written by deploy-stage.sh from .env. The token lets anyone post as the bot; the rendered
# config carries the chat id, which identifies the operator's own chat. The .tpl beside them is the
# committed one.
config/monitoring/alertmanager/telegram-token
config/monitoring/alertmanager/alertmanager.yml
