# Environment
.env
.env.local
.env.*.local
# Backups the treasury scripts take before editing .env. They hold DEPOSIT_MNEMONIC, so each is
# exactly as sensitive as .env itself and must never be committable.
.env.bak
.env.bak.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db


# Encrypted database dumps written by scripts/backup-treasury-db.sh. Encrypted, but still the
# whole off-chain ledger — never committable.
backups/
