# The MAINNET treasury's env file. Copy to .env.mainnet ON THE HOST and fill it in.
#
#   docker compose -p clutch-main-treasury --env-file .env.mainnet \
#     -f docker-compose.treasury.yml -f docker-compose.mainnet.treasury.yml up -d ...
#
# EVERY SECRET HERE MUST DIFFER FROM .env. This is not tidiness. TRON addresses are
# network-agnostic, so one DEPOSIT_MNEMONIC derives the SAME deposit addresses on Nile and on
# mainnet; two orchestrators with separate databases would then hand one address to two different
# users, and a depositor shown that address by the testnet app could send real USDT and have the
# mainnet service credit somebody else.
#
# Most of the file is generated for you, on the host, by:
#   ENV_FILE=.env.mainnet bash scripts/provision-treasury-secrets.sh
# It never overwrites and has no --force: replacing a mnemonic orphans every address already
# handed out, which on this network means real money with no way back.

# ---------------------------------------------------------------------------------------------
# YOU MUST SET THESE. Provisioning aborts without the first one.
# ---------------------------------------------------------------------------------------------

# A TRON MAINNET wallet YOU control, where swept USDT lands. Nothing in this stack can spend from
# it -- that is deliberate (readiness A4/A5), and it is why this is the only address that matters
# for custody. Do not reuse the testnet's.
CUSTODY_TRON_ADDRESS=

# TRON mainnet, not Nile. Required rather than defaulted, because a default that is wrong in this
# pair means watching the wrong token on the wrong network and crediting nothing.
TRONGRID_URL=https://api.trongrid.io

# USDT (TRC-20) on TRON mainnet. VERIFY THIS ON tronscan.org BEFORE SETTING IT -- the value below
# is what it is widely published as, and a wrong contract here watches a token nobody is sending.
USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Issued by trongrid.io against an account; the free tier's rate limits are low enough to stall
# deposit polling. Can be the same key as the testnet's -- it is a quota, not a secret about money.
TRONGRID_API_KEY=

# ---------------------------------------------------------------------------------------------
# The Azure KMS mint authority, from the key ceremony. Its address is this chain's
# genesis-committed mint_authority, so nothing else can ever mint here.
# ---------------------------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_VAULT_URL=https://clutch-mint-vault-1.vault.azure.net
AZURE_KEY_NAME=clutch-mint-key-1
# Pinned, never "latest": a new key version would change the mint authority's address under the
# running service without anyone deciding that.
AZURE_KEY_VERSION=

# Unused, and it must stay that way. The overlay sets APP_MINT_AUTHORITY_SECRET to empty, and
# treasury-service PANICS if a plaintext mint key is set alongside signer_kind=azure_kms.
# It has to exist because the base compose file interpolates ${MINT_AUTHORITY_SECRET:?...} before
# the overlay merges. Any placeholder works; a non-hex one fails closed if the overlay is dropped.
MINT_AUTHORITY_SECRET=unused-this-chain-signs-with-kms

# CORS for the deposit API. The mainnet app only.
MAINNET_ALLOWED_ORIGINS=https://app.clutchprotocol.io

# ---------------------------------------------------------------------------------------------
# Caps. Env vars, NOT genesis -- these can be changed later with set-mint-caps.sh, which runs
# check-cap-invariants.sh afterwards. Start conservative; raising one is a decision you can make
# with real numbers in front of you. See mainnet-readiness.md B4 for what each one bounds.
# ---------------------------------------------------------------------------------------------
PER_TX_MINT_CAP_CLT=50000000
DAILY_MINT_CAP_CLT=500000000
MAX_REDEMPTION_CLT=25000000
PER_TX_PAYOUT_CAP_USDT=25000000
MIN_REDEMPTION_CLT=5000000
REDEMPTION_FEE_USDT=1000000
DAILY_PAYOUT_CAP_CLT=100000000

# ---------------------------------------------------------------------------------------------
# GENERATED on the host by provision-treasury-secrets.sh. Leave blank; do not copy from .env.
# ---------------------------------------------------------------------------------------------
# DEPOSIT_MNEMONIC=        <- generated, never printed to a terminal or a log
# DEPOSIT_ACCOUNT_XPUB=    <- derived from it and checked against it on every run
# SIGNER_TOKEN=
# TREASURY_INITIATOR_TOKEN=
# TREASURY_APPROVER_TOKEN=
# TREASURY_READONLY_TOKEN=
# TREASURY_POSTGRES_PASSWORD=
# ORCHESTRATOR_POSTGRES_PASSWORD=
# JWT_SECRET=              <- must equal MAINNET_JWT_SECRET from .env, so the mainnet hub's
#                             tokens are the ones this orchestrator trusts
